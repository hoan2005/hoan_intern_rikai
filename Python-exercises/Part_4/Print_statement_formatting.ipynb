   "id": "ae6b4f61",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['1.23', '0.33', '0.11', '3.45']\n"
     ]
    }
   ],
   "source": [
    "def formatted(lis):\n",
    "    new_lis=[]\n",
    "    for i in lis:\n",
    "        new_lis.append(f\"{i:.2f}\")\n",
    "    return new_lis\n",
    "my_list = [1.234, 0.3333, 0.11111, 3.446]\n",
    "new_list = formatted(my_list)\n",
    "print(new_list)\n",
    "\n"
   ]
  }
