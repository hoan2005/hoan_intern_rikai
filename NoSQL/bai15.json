db.nghi_duong.aggregate([
  
  { 
    $unwind: "$reviews" 
  },
  
 
  {
    $group: {
      _id: { $year: "$reviews.date" },   
      total_reviews: { $sum: 1 }        
    }
  },
  
  
  {
    $sort: {
      _id: 1                           
    }
  },
  
  
  {
    $project: {
      _id: 0,                           
      year: "$_id",                     
      total_reviews: 1                  
    }
  }
])