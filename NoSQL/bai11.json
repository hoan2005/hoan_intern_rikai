db.nghi_duong.aggregate([

  {
    $match: {
      "address.market": "Sydney"
    }
  },

  {
    $facet: {

      "top_room_types": [
        { 
          $group: { 
            _id: "$room_type", 
            count: { $sum: 1 } 
          } 
        },
        { 
          $sort: { count: -1 } 
        },
        { 
          $limit: 3 
        },
        { 
          $project: { 
            _id: 0, 
            room_type: "$_id", 
            count: 1 
          } 
        }
      ],
      

      "price_stats": [
        { 
          $group: { 
            _id: null, 
            avg_price: { $avg: "$price" }, 
            min_price: { $min: "$price" }, 
            max_price: { $max: "$price" } 
          } 
        },
        { 
          $project: { 
            _id: 0, 
            avg_price: 1, 
            min_price: 1, 
            max_price: 1 
          } 
        }
      ]
    }
  }
])
